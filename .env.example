ASF_ENV=local
ASF_DEBUG=true
DATABASE_URL=postgresql+psycopg://asf:asf@localhost:5432/asf
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
GROQ_API_KEY=
# stub | groq | whisper — Mini App: Web Speech when capable, else server STT
STT_PROVIDER=groq
# For groq prefer whisper-large-v3-turbo (default if left as whisper-1)
STT_MODEL=whisper-large-v3-turbo
OWNER_TELEGRAM_ID=
# Studio / owner contacts on the client TZ (not secrets). Per-project override:
# KG Project entity payload.owner_contacts = {studio, name, email, phone, telegram, note}
STUDIO_NAME=
OWNER_CONTACT_NAME=
OWNER_CONTACT_EMAIL=
OWNER_CONTACT_PHONE=
OWNER_CONTACT_TELEGRAM=
# stub | groq — conversational Discovery (DEC-008/014) is off on stub (FSM fallback).
# Production: groq + GROQ_API_KEY. Tests keep stub.
LLM_PROVIDER=stub
# groq chat model when LLM_PROVIDER=groq (interview turns + outline + TZ polish).
LLM_MODEL=
# auto | llm | fsm — auto = llm when LLM_PROVIDER is not stub (DEC-008).
DISCOVERY_ENGINE=auto
MINIAPP_URL=
# Owner TZ console (/console/). Empty token allowed only when ASF_ENV=local and ASF_DEBUG=true
CONSOLE_TOKEN=
# Project file attachments (console + Mini App)
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=20971520
# Owner delivery-cost heuristic (draft TZ ready Telegram DM)
ASF_ESTIMATE_HOURLY_RATE=3000
ASF_ESTIMATE_CURRENCY=RUB
# Optional allowlisted HTTPS JSON for client market bands (DEC-012). Empty = builtin table.
ASF_MARKET_RATES_URL=
ASF_MARKET_RATES_ALLOWLIST=
# DEC-013 Intervention Queue (secrets are sealed; never put tokens in KG)
ASF_INTERVENTION_KEY=
ASF_INTERVENTION_TTL_HOURS=72
# Optional Cursor Cloud Agent. Empty = stub + manual export/deep-link
CURSOR_API_KEY=
CURSOR_CLOUD_API_URL=https://api.cursor.com
CURSOR_AGENT_REPO=
# VPS production: do not use this file as-is. GitHub Actions writes /opt/asf/.env
# from secrets (see .github/SECRETS.md and docs/16-VPS-Deploy.md).

