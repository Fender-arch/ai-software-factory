ASF_ENV=local
ASF_DEBUG=true
DATABASE_URL=postgresql+psycopg://asf:asf@localhost:5432/asf
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
GROQ_API_KEY=
# stub | groq | whisper — Mini App: Web Speech when capable, else server STT
STT_PROVIDER=groq
# For groq prefer whisper-large-v3-turbo (default if left as whisper-1)
STT_MODEL=whisper-large-v3-turbo
OWNER_TELEGRAM_ID=
LLM_PROVIDER=stub
# groq chat model when LLM_PROVIDER=groq (outline subsections). Leave empty for default.
LLM_MODEL=
MINIAPP_URL=
# Owner TZ console (/console/). Empty token allowed only when ASF_ENV=local and ASF_DEBUG=true
CONSOLE_TOKEN=
# Project file attachments (console + Mini App)
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=20971520
