{
  "name": "AI Software Factory",
  "install": "bash scripts/cloud-agent-install.sh",
  "start": "bash scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "api",
      "command": ". .venv/bin/activate && uvicorn apps.api.main:app --host 0.0.0.0 --port 8000 --reload",
      "description": "FastAPI app (health at /health, docs at /docs, Mini App at /miniapp/, owner console at /console/)."
    }
  ],
  "ports": [
    {
      "name": "api",
      "port": 8000
    }
  ]
}
